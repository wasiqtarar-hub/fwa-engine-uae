# Runtime state, not source.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.venv/
venv/

# The application's own database: seeded accounts, review outcomes, audit rows.
# It is created on first start and is specific to one deployment.
data/fwa.db

# The demonstration dataset is GENERATED, and reproducibly so:
#   python tools/make_demo_dataset.py --out data/claims_demo_synthetic.csv --calibrate
# It is kept in the delivered archive so a reader can load it without a
# three-minute build, but it is output rather than source.
data/claims_demo_synthetic*.csv
data/claims_demo_synthetic*.json

# Datasets loaded through the Data page. Content-addressed copies of whatever
# a user dragged in — theirs, not the repository's, and possibly sensitive.
data/uploads/

# Generated by the run, not authored. Both are reproducible with one command:
#   python -m fwa.run_validation
# reports/ is kept in the delivered archive because a reader should be able to
# see the output without running anything; in a repository it is build output.
data/synthetic_documents/
