# Runtime state, not source.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.venv/
venv/

# The application's own database: seeded accounts, review outcomes, audit rows.
# It is created on first start and is specific to one deployment.
data/fwa.db

# Datasets loaded through the Data page. Content-addressed copies of whatever
# a user dragged in — theirs, not the repository's, and possibly sensitive.
data/uploads/

# Committed deliberately (not ignored), so the repository runs without a build step:
#   data/claims_demo_synthetic*.csv / *.json — regenerate with:
#     python tools/make_demo_dataset.py --out data/claims_demo_synthetic.csv --calibrate
#   data/synthetic_documents/ — regenerate with:
#     python -m fwa.run_validation
# scratch builds made while developing the UAE demo generator
data/_scratch/

# Per-user interface preferences (Simple/Advanced mode), written by the app.
data/ui_prefs.json

# The unzipped UAE demo (68 MB). The committed data/uae_demo.zip holds the same
# tables; rebuild the folder with tools/make_uae_demo_dataset.py or unzip it.
data/uae_demo/
